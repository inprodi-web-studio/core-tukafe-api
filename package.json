{
  "name": "core-tukafe-api",
  "module": "src/app.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "start": "node --import tsx src/app.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node --import tsx scripts/seed-admin.ts",
    "promo:backfill": "node --import tsx scripts/backfill-order-promotion-state.ts",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "better-auth generate --config ./src/core/config/auth.config.ts",
    "auth:migrate": "better-auth migrate --config ./src/core/config/auth.config.ts",
    "scaffold": "plop --plopfile scripts/scaffold/plopfile.mjs",
    "scaffold:feature": "plop --plopfile scripts/scaffold/plopfile.mjs feature",
    "scaffold:action": "plop --plopfile scripts/scaffold/plopfile.mjs action",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/websocket": "^11.2.0",
    "@google-cloud/storage": "^7.19.0",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "@better-auth/cli": "^1.4.19",
    "better-auth": "^1.4.19",
    "dayjs": "^1.11.19",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.7.4",
    "fastify-type-provider-zod": "^6.1.0",
    "libphonenumber-js": "^1.12.37",
    "pg": "^8.18.0",
    "qs": "^6.15.0",
    "sharp": "^0.34.5",
    "tsx": "^4.22.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/qs": "^6.14.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "pino-pretty": "^13.1.3",
    "plop": "^4.0.5",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
