{
  "name": "core-tukafe-api",
  "module": "src/app.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "start": "node --import tsx src/app.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "node --env-file-if-exists=.env --import tsx scripts/prepare-cashback-db-push.ts && drizzle-kit push",
    "db:reset:dev": "node --import tsx scripts/run-dev-db-reset.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-admin.ts",
    "db:seed:baristas": "node --env-file-if-exists=.env --import tsx scripts/seed-barista-users.ts",
    "catalog:import": "node --import tsx scripts/run-catalog-import.ts",
    "catalog:sync-modifier-options": "node --import tsx scripts/run-product-modifier-options-sync.ts",
    "catalog:sync-modifier-visibility": "node --import tsx scripts/run-product-modifier-visibility-sync.ts",
    "catalog:sync-compound-components": "node --import tsx scripts/run-product-compound-components-sync.ts",
    "catalog:rollback": "node --import tsx scripts/run-catalog-rollback.ts",
    "customers:import": "node --import tsx scripts/run-customer-import.ts",
    "promo:backfill": "node --import tsx scripts/backfill-order-promotion-state.ts",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "better-auth generate --config ./src/core/config/auth.config.ts",
    "auth:migrate": "better-auth migrate --config ./src/core/config/auth.config.ts",
    "api-key:generate": "node --env-file-if-exists=.env --import tsx scripts/generate-api-key.ts",
    "scaffold": "plop --plopfile scripts/scaffold/plopfile.mjs",
    "scaffold:feature": "plop --plopfile scripts/scaffold/plopfile.mjs feature",
    "scaffold:action": "plop --plopfile scripts/scaffold/plopfile.mjs action",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.14",
    "@better-auth/cli": "^1.4.21",
    "@better-auth/core": "1.6.14",
    "@better-auth/utils": "0.4.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/websocket": "^11.2.0",
    "@google-cloud/storage": "^7.19.0",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.6.14",
    "better-call": "1.3.5",
    "dayjs": "^1.11.19",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.7.4",
    "fastify-type-provider-zod": "^6.1.0",
    "libphonenumber-js": "^1.12.37",
    "pg": "^8.18.0",
    "qs": "^6.15.0",
    "sharp": "^0.34.5",
    "stripe": "^18.0.0",
    "tsx": "^4.22.3",
    "twilio": "^6.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/qs": "^6.14.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "pino-pretty": "^13.1.3",
    "plop": "^4.0.5",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "yarn@4.16.0"
}
