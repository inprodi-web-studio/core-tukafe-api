NODE_ENV=development
PORT=8081
HOST=0.0.0.0
PUBLIC_URL=http://localhost:5175
API_URL=http://localhost:8081
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tukafe
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_CERT=
BETTER_AUTH_SECRET=replace-with-at-least-32-characters

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_FROM_PHONE_NUMBER=+521234567890

# Google Cloud Storage (Uploads)
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCS_PUBLIC_BUCKET=
GCS_PRIVATE_BUCKET=
GCS_UPLOADS_PREFIX=uploads

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MERCHANT_COUNTRY_CODE=MX
STRIPE_APPLE_MERCHANT_ID=
STRIPE_GOOGLE_PAY_ENABLED=true
STRIPE_GOOGLE_PAY_TEST_ENV=true

# Multipart upload limits
UPLOAD_MAX_FILES_PER_REQUEST=10
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
